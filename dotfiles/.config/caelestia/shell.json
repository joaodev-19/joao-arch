{
    "appearance": {
        "transparency": {
            "base": 0.85,
            "enabled": true,
            "layers": 0.45
        }
    },
    "bar": {
        "persistent": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": false,
                "id": "battery"
            }
        ],
        "workspaces": {
            "shown": 5
        }
    },
    "dashboard": {
        "enabled": true,
        "performance": {
            "showBattery": false,
            "showCpu": true,
